# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fake_job_detection

# Model
MODEL_ARTIFACT_DIR=ai_service/models_store/bert_fraud_classifier
FRAUD_DECISION_THRESHOLD=0.5

# CORS (comma-separated origins allowed to call this service directly, e.g. during local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# URL scraping
SCRAPER_REQUEST_TIMEOUT_SECONDS=10
SCRAPER_MAX_RESPONSE_BYTES=5242880

# Uploads
MAX_PDF_UPLOAD_BYTES=10485760
MAX_IMAGE_UPLOAD_BYTES=5242880

# OCR engine: "easyocr" or "tesseract"
OCR_ENGINE=easyocr
