# Analysis service settings (all optional — these are the defaults).
HOST=127.0.0.1
PORT=8000

# Local reasoning model served by Ollama (https://ollama.com).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Reasoning on CPU-only machines can take a minute.
LLM_TIMEOUT_SECONDS=120

# Web verification
VERIFICATION_TIMEOUT_SECONDS=6
SEARCH_BACKENDS=duckduckgo,google,brave,bing
SCRAPER_REQUEST_TIMEOUT_SECONDS=12
SCRAPER_MAX_RESPONSE_BYTES=5242880

# OCR engine: "rapidocr" (default, pip-only) or "tesseract" (needs Tesseract installed)
OCR_ENGINE=rapidocr
