# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fake_job_detection

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI service
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Uploads
MAX_PDF_UPLOAD_BYTES=10485760
MAX_IMAGE_UPLOAD_BYTES=5242880

# Reverse proxy hops to trust for X-Forwarded-For (Express "trust proxy").
# Leave at 0 for `npm run dev` (nothing proxies this directly). Set to 1
# behind the Docker Compose nginx frontend — see backend/config/env.js.
TRUST_PROXY=0
