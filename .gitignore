__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Embedded database & test coverage ---
backend/.data/
backend/coverage/

# --- Node / JS ---
node_modules/
frontend/dist/
frontend/build/
backend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
